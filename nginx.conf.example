# Nginx front end for FakaApache.
# FakaApache serves static files on 127.0.0.1:8080.
# Nginx handles public HTTP/TLS and proxies application routes.

events {}

http {
    upstream fakaapache_static {
        server 127.0.0.1:8080;
    }

    upstream application_backend {
        server 127.0.0.1:3000;
    }

    server {
        listen 80;
        server_name example.com;

        location /api/ {
            proxy_pass http://application_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            proxy_pass http://fakaapache_static;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
